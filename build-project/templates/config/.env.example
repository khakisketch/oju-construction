# ============================================
# PROJECT CONFIGURATION
# ============================================
# 이 파일을 .env.local로 복사하여 사용하세요
# init-project.js 스크립트가 자동으로 생성합니다

# ============================================
# PROJECT INFO (자동 치환됨)
# ============================================
NEXT_PUBLIC_PROJECT_NAME={{PROJECT_NAME}}
NEXT_PUBLIC_SITE_NAME={{PROJECT_NAME_DISPLAY}}
NEXT_PUBLIC_COMPANY_NAME={{COMPANY_NAME}}

# ============================================
# FIREBASE CONFIGURATION
# ============================================
# Firebase Console → 프로젝트 설정 → 일반 → 웹 앱에서 확인
# https://console.firebase.google.com/project/{{FIREBASE_PROJECT_ID}}/settings/general

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN={{FIREBASE_PROJECT_ID}}.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID={{FIREBASE_PROJECT_ID}}
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET={{FIREBASE_PROJECT_ID}}.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# ============================================
# SITE SETTINGS
# ============================================
# 기본 연락처 정보
NEXT_PUBLIC_CONTACT_EMAIL={{CONTACT_EMAIL}}
NEXT_PUBLIC_CONTACT_PHONE={{CONTACT_PHONE}}

# 사이트 URL (배포 후)
NEXT_PUBLIC_SITE_URL=https://{{FIREBASE_PROJECT_ID}}.web.app

# ============================================
# SEO DEFAULTS
# ============================================
NEXT_PUBLIC_META_TITLE={{PROJECT_NAME_DISPLAY}} | 공식 웹사이트
NEXT_PUBLIC_META_DESCRIPTION={{COMPANY_NAME}} 공식 웹사이트입니다
NEXT_PUBLIC_META_KEYWORDS={{PROJECT_NAME_DISPLAY}},{{COMPANY_NAME}}

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
# 개발 서버 포트
PORT=5566

# Node 환경
NODE_ENV=development

# ============================================
# OPTIONAL: ANALYTICS & MARKETING
# ============================================
# Google Analytics 4
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel
# NEXT_PUBLIC_META_PIXEL_ID=

# Naver Analytics
# NEXT_PUBLIC_NAVER_ANALYTICS_ID=

# ============================================
# OPTIONAL: EMAIL NOTIFICATIONS
# ============================================
# Contact 폼 제출 시 이메일 알림 (Firebase Functions 사용)
# EMAIL_NOTIFICATION_ENABLED=false
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=

# ============================================
# OPTIONAL: CUSTOM DOMAIN
# ============================================
# 커스텀 도메인 사용 시
# NEXT_PUBLIC_CUSTOM_DOMAIN=www.{{PROJECT_NAME}}.com
